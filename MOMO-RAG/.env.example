# 비밀값을 직접 채우고 Git에 추가하지 않는다.
SERVICE_TOKEN=
# stub은 외부 연결 없는 개발용, atlas는 실제 OpenAI·MongoDB 연동
RAG_ENGINE=stub
# 실제 비밀값은 이 예제가 아닌 추적하지 않는 .env에 직접 설정
OPENAI_API_KEY=
MONGODB_URI=
# Atlas 데이터베이스·컬렉션·벡터 인덱스 이름
MONGODB_DB=momo_rag
MONGODB_COLLECTION=review_chunks
ATLAS_INDEX_NAME=review_vector_index
# 임베딩·답변 모델 및 벡터 차원 (인덱스 JSON과 일치)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini
EMBEDDING_DIMENSIONS=1536
# 리뷰 청크 크기·겹침과 검색 점수·재작성 상한
CHUNK_SIZE=500
CHUNK_OVERLAP=80
MIN_SCORE=0.78
MAX_REWRITES=1
# 한국 날짜 기준 요청 횟수 상한: 재시작 시 초기화되며 절대 금액 제한은 아님
DAILY_EMBEDDING_REQUESTS=500
DAILY_LLM_REQUESTS=200
# 개별 외부 호출 제한과 다음 호출 진입을 제한하는 전체 처리 예산(초)
EMBEDDING_TIMEOUT_SECONDS=4
REWRITE_TIMEOUT_SECONDS=5
ANSWER_TIMEOUT_SECONDS=8
MONGO_TIMEOUT_SECONDS=3
INDEX_BUDGET_SECONDS=12
QUERY_BUDGET_SECONDS=25
