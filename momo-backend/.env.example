# 실제 인증정보가 없는 환경설정 예시 파일
# .env로 복사한 후 개인 개발 환경에 맞게 설정한다.
# 기존 DB 비밀번호와 JWT 서명키를 임의로 변경하지 않는다.


# ==========================================
# 1. MySQL 데이터베이스 설정
# ==========================================

DB_URL=jdbc:mysql://localhost:3306/momo_db?serverTimezone=Asia/Seoul
DB_USERNAME=
DB_PASSWORD=


# ==========================================
# 2. JWT 인증 설정
# ==========================================

# JWT 서명키
JWT_SECRET=

# Access Token 유효시간 (30분)
JWT_ACCESS_EXP_MS=1800000

# Refresh Token 유효시간 (7일)
JWT_REFRESH_EXP_MS=604800000


# ==========================================
# 3. 외부 영화 API 설정
# ==========================================

# 영화진흥위원회 API
KOBIS_API=

# 한국영화데이터베이스 API
KMDB_API=

# The Movie Database API
TMDB_API=


# ==========================================
# 4. CORS 설정
# ==========================================

# 프론트엔드 접근 허용 주소
MOMO_CORS_ALLOWED_ORIGINS=http://localhost:3000


# ==========================================
# 5. 카카오 간편 로그인 설정
# ==========================================

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 회원 탈퇴 시 카카오 연결 해제용 서버 Admin Key
KAKAO_ADMIN_KEY=


# ==========================================
# 6. 네이버 간편 로그인 설정
# ==========================================

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:3000/oauth/naver


# ==========================================
# 7. Google 간편 로그인 설정
# ==========================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google


# ==========================================
# 8. RAG 엔진 및 FastAPI 연결 설정
# ==========================================

# 실행 방식 (stub: 개발 및 테스트 / atlas: 실제 AI 연동)
RAG_ENGINE=stub

# RAG 서비스 활성화 여부
RAG_ENABLED=false

# FastAPI 서버 주소
RAG_BASE_URL=http://127.0.0.1:8000

# Python SERVICE_TOKEN과 동일하게 설정
RAG_SERVICE_TOKEN=


# ==========================================
# 9. RAG 질문 기능 설정
# ==========================================

# AI 질문 기능 활성화 여부
# Atlas 최초 전환 시 전체 재색인 완료까지 false로 설정
RAG_QUERY_ENABLED=true


# ==========================================
# 10. RAG 타임아웃 설정 (밀리초)
# ==========================================

# FastAPI 연결 제한 시간
RAG_CONNECT_TIMEOUT_MS=500
RAG_QUERY_CONNECT_TIMEOUT_MS=500

# 엔진별 기본 응답 제한 시간
# Stub  : 색인 1000 / 질문 10000
# Atlas : 색인 15000 / 질문 30000

# 기본값을 변경할 경우 주석을 해제하여 설정
# RAG_READ_TIMEOUT_MS=15000
# RAG_QUERY_READ_TIMEOUT_MS=30000


# ==========================================
# 11. RAG 운영자 및 재색인 권한 설정
# ==========================================

# 운영자 재색인 기능 활성화 여부
RAG_REINDEX_ENABLED=false

# 재색인 권한을 가진 회원 ID
# 운영자 ID는 서버에서만 관리하며
# 프론트엔드에는 권한 여부(boolean)만 제공
RAG_REINDEX_OPERATOR_IDS=